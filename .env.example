# =============================================================================
# Variables de Entorno — Sistema de Gestión de Talento Humano y Nómina
# =============================================================================
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env al repositorio.
# =============================================================================

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-segura-de-50-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# PostgreSQL
POSTGRES_DB=nomina_db
POSTGRES_USER=nomina_user
POSTGRES_PASSWORD=cambiar-por-password-seguro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superusuario inicial
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ejemplo.com
DJANGO_SUPERUSER_PASSWORD=cambiar-por-password-seguro

# Linode (solo para Terraform — no usar en la app)
# LINODE_TOKEN=tu-token-de-api-linode
